# Copy to .env (never commit it). Everything is optional: with no .env the app runs the
# offline engine on http://127.0.0.1:3000.

# --- Server ---
# NODE_ENV=production          # set by the Docker image
PORT=3000
HOST=127.0.0.1                 # 0.0.0.0 in a container
# TRUST_PROXY=false            # number of reverse proxies you control in front (true = 1); rate limits
#                              # then use the X-Forwarded-For entry your proxy wrote, never the client's
# ALLOWED_HOSTS=               # comma-separated Host names to answer; defaults to localhost,127.0.0.1,[::1]
#                              # when HOST is loopback (DNS-rebinding guard), any host otherwise
# HSTS=false                   # true when served over HTTPS
# PUBLIC_URL=                  # e.g. https://guides.example.com, for links in Markdown exports
# DATA_DIR=.data               # where shared generated guides are stored

# --- Live research agent (optional) ---
# Set a key to switch the Live Generator from the offline engine to Claude + web search.
# ANTHROPIC_API_KEY=           # from your secret manager in production; never commit it
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com   # e.g. a company API gateway
# LIVE_MODE=on                 # off keeps the offline engine even when a key is set
# LIVE_MAX_SEARCHES=5          # web searches per run ($10 per 1,000 searches, plus tokens)
# LIVE_TIMEOUT_MS=150000
# LIVE_MAX_TOKENS=8000

# --- Offline engine ---
# DISCOVERY_PROBE=on           # fetch OAuth discovery metadata from the provider's domain
# DISCOVERY_TIMEOUT_MS=3000
# DISCOVERY_BUDGET_MS=7000
# AGENT_PACE=1                 # 0 = no pacing between steps; 1 = readable pace

# --- Abuse and cost controls ---
# GENERATE_RATE_LIMIT=10       # fresh generations per client per window
# GENERATE_RATE_WINDOW_MS=600000
# GENERATE_MAX_CONCURRENT=4
# GENERATE_CACHE_TTL_MS=86400000
# SHARE_STORE_MAX=2000
